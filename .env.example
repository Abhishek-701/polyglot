# Copy to .env and fill in as later milestones need real values.
# Nothing here is required for M0.

# POLYGLOT_FLAGS__RETRIEVAL_BRIDGE=mt

# M3: pgvector/postgres DSN used by polyglot/retrieval/ingest.py and
# eval/retrieval_eval.py. Defaults to localhost:5433 (not 5432 — this dev
# machine already runs a native Postgres service on 5432; see
# docker-compose.yml and PROGRESS.md M3 notes). Only needed if your own
# environment's port differs from the docker-compose default.
# POLYGLOT_DB_DSN=postgresql://polyglot:polyglot@localhost:5433/polyglot
